---
import { AstroFont } from 'astro-font';
import AppFooter from "../components/AppFooter.astro";
import AppHeader from "../components/AppHeader.astro";
import "./../tailus.css"

// Define las propiedades que pueden ser pasadas a este componente
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

// Valores por defecto para SEO
const { 
    title = "Fortino Romero | Cloud Engineer & AWS Advocate", 
    description = "Fortino Romero Mantilla Cloud Engineer specialized in AWS, DevOps, and IoT solutions. Professional portfolio with projects, certifications, and experience.",
    image = "/images/profile-image.jpeg"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        
        <!-- SEO Básico -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Fortino Romero" />
        <meta name="google-site-verification" content="eeV202wGUJm0GtgglXJkda3PD75pwRjpe2uLoCyr1ZA" />
        
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.url)} />
        
        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(image, Astro.url)} />
        
        <!-- Palabras clave -->
        <meta name="keywords" content="cloud computing, AWS, DevOps, IoT, ingeniero de nube, ingeniería de software, Fortino Romero, Fortino, Romero, Mantilla, Fortino Romero Mantilla, Cloud engineer, UTP" />

        <!-- Canonical URL -->
        <link rel="canonical" href={Astro.url} />


        <AstroFont
            config={[
                {
                    src: [],
                    name: "Urbanist",
                    preload: true,
                    display: "swap",
                    selector: "html",
                    fallback: "sans-serif",
                    googleFontsURL: 'https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700&display=swap',
                },
            ]}
        />

        <!-- Schema.org para Rich Snippets -->
<script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Fortino Romero Mantilla",
      "givenName": "Fortino",
      "familyName": "Romero Mantilla",
      "url": "https://foor.dev",
      "image": "https://foor.dev/images/profile-image.jpeg",
      "jobTitle": "Cloud Engineer & AWS Advocate",
      "description": "Cloud Engineer specialized in AWS, DevOps, and IoT solutions. Professional portfolio with projects, certifications, and experience.",
    "sameAs": [
      "https://www.linkedin.com/in/fortino-romero",
      "https://github.com/fortino-romero",
      "mailto:fortino.rom@gmail.com",
      "https://x.com/for_rm",
      "https://instagram.com/for.rm"
      ],
      "knowsAbout": ["AWS", "Cloud Computing", "DevOps", "IoT"]
    }
    </script>
    </head>
    <body class="bg-white dark:bg-gray-950">
        <AppHeader />
        <slot />
        <AppFooter />
    </body>
</html>
