---
import Container from "./Container.astro";

// Define publications data
const publications = [
  {
    title: "Fortino Romero to Represent Mexico in Japan",
    publisher: "Universidad Tecnológica de Puebla",
    type: "Official Bulletin & Social Media",
    summary: "Recognition of international participation with Mirai Institute",
    link: "https://www.youtube.com/watch?v=OW_GfpqfAU8", // Replace with actual link
    image: "/images/publications/utp-japan.webp" // Replace with actual image path
  },
  {
    title: "ANUIES4MX Challenge Winners",
    publisher: "ANUIES Official Website",
    type: "National Recognition",
    summary: "Fortino Romero Mantilla was one of the 20 national winners who participated in the technological innovation challenge.",
    link: "https://www.mirai-innovation-lab.com/anuies4mx-resultados/", // Replace with actual link
    image: "/images/publications/anuies-winners.webp" // Replace with actual image path
  },
  {
    title: "Mirai Institute Presents Fortino Romero",
    publisher: "Mirai Innovation Official Facebook",
    type: "Video Feature",
    summary: "Presentation video where you share your participation and your goals with technology",
    link: "https://www.youtube.com/watch?v=vDaMqDtjPWE", // Replace with actual link to Facebook video
    image: "/images/publications/mirai-video.webp" // Replace with actual image path
  },
  {
    title: "Academic Mentions in UTP Bulletins",
    publisher: "Universidad Tecnológica de Puebla",
    type: "Various Mentions",
    summary: "Mentions for achievements, book participation, hackathons, etc.",
    link: "https://drive.google.com/file/d/1yELQ9dJAlfHmWSCrcgJIKreWluyJ9K0o/view", // Replace with actual link
    image: "/images/publications/utp-bulletins.webp" // Replace with actual image path
  }
];
---

<div id="publications" class="relative py-6 md:py-4">
  <div aria-hidden="true" class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-40 dark:opacity-20">
    <div class="blur-[106px] h-56 bg-gradient-to-br from-blue-600 to-cyan-400 dark:from-blue-700"></div>
    <div class="blur-[106px] h-32 bg-gradient-to-r from-cyan-400 to-sky-300 dark:to-indigo-600"></div>
  </div>
  
  <Container>
    <div class="relative">
      <div class="flex flex-col md:flex-row gap-10 md:gap-16 mb-12">
        <div class="md:w-2/3">
          <h2 class="text-3xl font-bold text-gray-900 md:text-4xl dark:text-white">
            Media <span class="text-blue-600 dark:text-blue-400">Publications</span>
          </h2>
          <p class="my-8 text-gray-600 dark:text-gray-300 leading-relaxed">
            My work and contributions have been featured in academic publications and media by institutions such as ANUIES, Mirai Innovation and Universidad Tecnológica de Puebla.
          </p>
        </div>
      </div>
      
      <!-- Publications Slider -->
      <div class="relative mt-12">
        <!-- Navigation Arrows -->
        <div class="absolute top-1/2 -left-4 md:-left-6 z-10 transform -translate-y-1/2">
          <button 
            id="prev-publication" 
            class="p-2 rounded-full bg-white/80 shadow-md dark:bg-gray-800/80 text-gray-800 dark:text-gray-200 hover:bg-white dark:hover:bg-gray-700 transition-all"
            aria-label="Previous publication"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </button>
        </div>

        <div class="overflow-hidden">
          <div id="publications-container" class="flex transition-all duration-500 ease-in-out">
            {
              publications.map((pub) => (
                <div class="min-w-full md:min-w-[calc(50%-1rem)] lg:min-w-full p-4">
                  <div class="h-full bg-white dark:bg-gray-800 rounded-2xl shadow-sm overflow-hidden">
                    <div class="flex flex-col lg:flex-row">
                      <div class="lg:w-1/2">
                        <img 
                          src={pub.image} 
                          alt={pub.title} 
                          class="w-full h-64 lg:h-140 object-cover object-center"
                          loading="lazy"
                        />
                      </div>
                      <div class="p-6 lg:w-1/2 flex flex-col justify-center">
                        <div class="mb-4">
                          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 inline-block mb-2">
                            {pub.type}
                          </span>
                          <h3 class="font-semibold text-xl lg:text-2xl text-gray-800 dark:text-white mb-2">
                            {pub.title}
                          </h3>
                          <p class="text-gray-700 dark:text-gray-300 font-medium mb-4">
                            {pub.publisher}
                          </p>
                          <p class="text-gray-600 dark:text-gray-400 mb-6">
                            {pub.summary}
                          </p>
                          
                          <a 
                            href={pub.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:underline"
                          >
                            View publication
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 ml-1">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                            </svg>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="absolute top-1/2 -right-4 md:-right-6 z-10 transform -translate-y-1/2">
          <button 
            id="next-publication" 
            class="p-2 rounded-full bg-white/80 shadow-md dark:bg-gray-800/80 text-gray-800 dark:text-gray-200 hover:bg-white dark:hover:bg-gray-700 transition-all"
            aria-label="Next publication"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Slider Indicators -->
      <div class="flex justify-center mt-8 gap-2">
        {publications.map((_, index) => (
          <button 
            class={`slider-indicator w-2.5 h-2.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-blue-600 dark:bg-blue-400 w-8' : 'bg-gray-300 dark:bg-gray-700'}`}
            data-index={index}
            aria-label={`Go to publication ${index + 1}`}
          ></button>
        ))}
      </div>
    </div>
  </Container>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('publications-container');
    const prevBtn = document.getElementById('prev-publication');
    const nextBtn = document.getElementById('next-publication');
    const indicators = document.querySelectorAll('.slider-indicator');
    
    let currentIndex = 0;
    const publicationCount = indicators.length;
    
    // Determine visible count based on screen width
    const getVisibleCount = () => {
      if (window.innerWidth >= 768) return 1; // One per view on all screen sizes for better readability
      return 1;
    };
    
    const updateSliderPosition = () => {
      const visibleCount = getVisibleCount();
      const maxIndex = publicationCount - visibleCount;
      
      // Ensure currentIndex doesn't go beyond limits
      if (currentIndex > maxIndex) currentIndex = maxIndex;
      if (currentIndex < 0) currentIndex = 0;
      
      // Calculate slide position
      const slideWidth = 100 / visibleCount;
      const position = -currentIndex * slideWidth;
      
      // Apply transform
      container.style.transform = `translateX(${position}%)`;
      
      // Update indicators
      indicators.forEach((indicator, index) => {
        if (index === currentIndex) {
          indicator.classList.add('bg-blue-600', 'dark:bg-blue-400', 'w-8');
          indicator.classList.remove('bg-gray-300', 'dark:bg-gray-700', 'w-2.5');
        } else {
          indicator.classList.remove('bg-blue-600', 'dark:bg-blue-400', 'w-8');
          indicator.classList.add('bg-gray-300', 'dark:bg-gray-700', 'w-2.5');
        }
      });
    };
    
    // Event listeners
    prevBtn.addEventListener('click', () => {
      currentIndex = Math.max(0, currentIndex - 1);
      updateSliderPosition();
    });
    
    nextBtn.addEventListener('click', () => {
      const visibleCount = getVisibleCount();
      const maxIndex = publicationCount - visibleCount;
      currentIndex = Math.min(maxIndex, currentIndex + 1);
      updateSliderPosition();
    });
    
    // Add click events to indicators
    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        currentIndex = index;
        updateSliderPosition();
      });
    });
    
    // Handle window resize
    window.addEventListener('resize', updateSliderPosition);
    
    // Initialize
    updateSliderPosition();
  });
</script>