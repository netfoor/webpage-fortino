---
import Container from "./Container.astro";

// Define certifications data
const certifications = [
  {
    title: "IT Support Professional Certificate",
    issuer: "Google",
    date: "November 29, 2023",
    skills: "Networking, OS, Security, HCI, Theoretical Computer Science",
    logo: "/images/certifications/google.png",
    color: "bg-orange-100 dark:bg-orange-900/20",
    textColor: "text-orange-600 dark:text-orange-400"
  },
  {
    title: "CCNA: Introduction to Networks",
    issuer: "Cisco",
    date: "May 21, 2024",
    skills: "IP, Subnetting, IPv4/6, Network Fundamentals, Ethernet",
    logo: "/images/certifications/cisco.png",
    color: "bg-blue-100 dark:bg-blue-900/20",
    textColor: "text-blue-600 dark:text-blue-400"
  },
  {
    title: "Introduction to Emerging Technologies",
    issuer: "Emtech & Santander",
    date: "March 11, 2024",
    skills: "Cloud Computing, IoT, ML, Cybersecurity, 5G, Blockchain, Edge, Big Data",
    logo: "/images/certifications/emtech.png",
    color: "bg-green-100 dark:bg-green-900/20",
    textColor: "text-green-600 dark:text-green-400"
  }
];
---

<div id="certifications" class="relative py-16 md:py-24">
  <div aria-hidden="true" class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-40 dark:opacity-20">
    <div class="blur-[106px] h-56 bg-gradient-to-br from-purple-500 to-indigo-400 dark:from-purple-700"></div>
    <div class="blur-[106px] h-32 bg-gradient-to-r from-violet-400 to-purple-300 dark:to-indigo-600"></div>
  </div>
  
  <Container>
    <div class="relative">
      <div class="space-y-6 justify-between text-gray-600 md:flex md:gap-6 md:space-y-0 lg:gap-12 lg:items-center">
        <div class="md:5/12 lg:w-1/2">
          <div class="grid grid-cols-2 gap-4">
            {certifications.map((cert) => (
              <div class="p-4 grayscale transition duration-200 hover:grayscale-0 hover:-translate-y-1">
                <img 
                  src={cert.logo} 
                  alt={`${cert.issuer} logo`} 
                  class="h-16 w-auto mx-auto" 
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
        
        <div class="md:7/12 lg:w-1/2">
          <h2 class="text-3xl font-bold text-gray-900 md:text-4xl dark:text-white">
            Certifications & <span class="text-purple-600 dark:text-purple-400">Training</span>
          </h2>
          <p class="my-8 text-gray-600 dark:text-gray-300">
            I constantly seek to improve my skills and stay up to date in emerging technologies through certified training.
          </p>
          <div class="divide-y space-y-4 divide-gray-100 dark:divide-gray-800">
            {certifications.map((cert) => (
              <div class="mt-8 flex gap-4 md:items-center">
                <div class={`w-12 h-12 flex gap-4 rounded-full ${cert.color}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class={`w-6 h-6 m-auto ${cert.textColor}`}>
                    <path fill-rule="evenodd" d="M4.5 3.75a3 3 0 00-3 3v10.5a3 3 0 003 3h15a3 3 0 003-3V6.75a3 3 0 00-3-3h-15zm4.125 3a2.25 2.25 0 100 4.5 2.25 2.25 0 000-4.5zm-3.873 8.703a4.126 4.126 0 017.746 0 .75.75 0 01-.351.92 7.47 7.47 0 01-3.522.877 7.47 7.47 0 01-3.522-.877.75.75 0 01-.351-.92zM15 8.25a.75.75 0 000 1.5h3.75a.75.75 0 000-1.5H15zM14.25 12a.75.75 0 01.75-.75h3.75a.75.75 0 010 1.5H15a.75.75 0 01-.75-.75zm.75 2.25a.75.75 0 000 1.5h3.75a.75.75 0 000-1.5H15z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="w-5/6">
                  <h3 class={`font-semibold text-lg ${cert.textColor}`}>{cert.title} – {cert.issuer}</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Issued: {cert.date}</p>
                  <p class="text-gray-500 dark:text-gray-400">{cert.skills}</p>
                </div> 
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Container>
</div>