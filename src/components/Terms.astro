---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms of Service - Fortino Romero" description="Terms of service and usage for Fortino Romero's personal website.">
  <div class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-8">Terms of Service</h1>
      
      <div class="prose dark:prose-invert">
        <p>Last updated: {new Date().toLocaleDateString()}</p>
        
        <h2>1. Introduction</h2>
        <p>By accessing this website, you agree to be bound by these terms of service. This website is owned and operated by Fortino Romero.</p>
        
        <h2>2. Use License</h2>
        <p>All content on this site is for informational purposes only. The content is owned by or licensed to Fortino Romero and is protected by copyright laws.</p>
        
        <h2>3. Disclaimer</h2>
        <p>The materials on this website are provided on an 'as is' basis. Fortino Romero makes no warranties, expressed or implied, and hereby disclaims all other warranties.</p>
        
      </div>
    </div>
  </div>
</Layout>