---
import Container from "./Container.astro"
import Social from "../components/social.astro";
---

<div class="relative" id="home">
    <div aria-hidden="true" class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-40 dark:opacity-20">
      <div class="blur-[106px] h-56 bg-gradient-to-br from-gray-500 to-gray-400 dark:from-gray-700"></div>
      <div class="blur-[106px] h-32 bg-gradient-to-r from-gray-400 to-gray-300 dark:to-gray-600"></div>
    </div>
    <Container>
        <div class="relative pt-40 ml-auto">
            <div class="lg:w-2/3 text-center mx-auto">
                <div class="flex justify-center mb-8">
                  <div class="relative w-40 h-40 rounded-full overflow-hidden border-2 from-gray-400 to-gray-500 dark:border-gray-700 bg-gradient-to-br">
                    <img 
                      src="/images/profile-image.jpeg"
                      alt="Profile Image" 
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                </div>
                <h1 class="text-gray-900 text-balance dark:text-white font-bold text-3xl md:text-4xl xl:text-5xl">Fortino Romero</h1>
                <p class="mt-8 text-gray-700 dark:text-gray-300">Cloud Engineer | AWS Advocate | DevOps Enthusiast</p>

                <Social />


                
                
                <p class="mt-12 text-gray-500 dark:text-gray-400">
                  <span id="typed-text"></span>
                </p>
                <script>
                  const text = "Building real-world impact through cloud technology, one solution at a time.";
                  const typedTextSpan = document.getElementById("typed-text");
                  let index = 0;

                  function type() {
                  if (index < text.length) {
                    typedTextSpan.textContent += text.charAt(index);
                    index++;
                    setTimeout(type, 30); // Adjust typing speed here (milliseconds)
                  }
                  }

                  document.addEventListener("DOMContentLoaded", () => {
                  typedTextSpan.textContent = ""; // Clear any initial content
                  index = 0; // Reset index
                  type(); // Start typing animation
                  });
                </script>

