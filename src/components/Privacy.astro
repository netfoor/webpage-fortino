---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy - Fortino Romero" description="Privacy policy for Fortino Romero's personal website.">
  <div class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-8">Privacy Policy</h1>
      
      <div class="prose dark:prose-invert">
        <p>Last updated: {new Date().toLocaleDateString()}</p>
        
        <h2>1. Information We Collect</h2>
        <p>This website does not collect personal data except what is provided through contact forms or analytics services for site improvement.</p>
        
        <h2>2. Use of Information</h2>
        <p>Any information collected is used solely to improve user experience or to respond to inquiries.</p>
        
        <h2>3. Cookies</h2>
        <p>This website may use cookies to enhance user experience. Users can disable cookies in their browser settings if desired.</p>
        
      </div>
    </div>
  </div>
</Layout>